#!/usr/bin/env bash
# pre-push — 本專案**不使用 GitHub Actions**（CI 有分鐘數限制）。所有驗證在
# 本機跑完才允許推上去；這支 hook 就是唯一的 gate，內容與 CI 原本跑的相同，
# 且**不跳過**真 pi 載入與 laya latency。
#
# 安裝（clone 後跑一次）：git config core.hooksPath .githooks
# 刻意略過：git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "[pre-push] scripts/accept.sh（typecheck + tests + 真 pi 載入 + laya latency + 靜態驗收）"
if ! bash scripts/accept.sh; then
  echo "[pre-push] 驗收失敗——push 已中止（要硬推請用 git push --no-verify）" >&2
  exit 1
fi
