{
  "name": "pi-compass-router",
  "version": "0.10.1",
  "description": "pi extension that decides which model and thinking level each turn should use, then switches before the turn starts.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckijficqstrvy/pi-compass-router.git"
  },
  "homepage": "https://github.com/ckijficqstrvy/pi-compass-router#readme",
  "bugs": {
    "url": "https://github.com/ckijficqstrvy/pi-compass-router/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-compass-router/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "files": [
    "extensions",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "refresh-facts": "node scripts/refresh-facts.mjs",
    "test": "esbuild test/*.test.ts --bundle --packages=external --platform=node --format=esm --outdir=build/test && node --test build/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "typebox": "^1.3.34",
    "typescript": "^5.6.0"
  }
}
